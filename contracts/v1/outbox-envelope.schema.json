{
  "$id": "urn:hermodr:contract:v1:outbox-envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {"type": "object"},
    "event_id": {"pattern": "^evt_[a-f0-9]{32}$", "type": "string"},
    "event_type": {"enum": ["observation.recorded", "transition.recorded", "visit.recorded", "trip.recorded", "coverage_gap.recorded", "place.recorded", "record.superseded", "record.tombstoned"], "type": "string"},
    "occurred_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$", "type": "string"},
    "privacy_class": {"const": "restricted", "type": "string"},
    "provenance": {"items": {"pattern": "^[a-z]+_[a-f0-9]{20,64}$", "type": "string"}, "type": "array"},
    "published_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$", "type": "string"},
    "schema_version": {"const": "1", "type": "string"},
    "sequence": {"minimum": 1, "type": "integer"},
    "subject_id": {"pattern": "^sub_[a-f0-9]{8,64}$", "type": "string"}
  },
  "required": ["event_id", "sequence", "event_type", "schema_version", "occurred_at", "published_at", "subject_id", "privacy_class", "provenance", "data"],
  "title": "Hermodr outbox envelope v1",
  "type": "object"
}
