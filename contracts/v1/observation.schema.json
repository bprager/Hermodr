{
  "$id": "urn:hermodr:contract:v1:observation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {"const": "owntracks-normalizer-v1", "type": "string"},
    "algorithm_config_version": {"pattern": "^[a-f0-9]{16}$", "type": "string"},
    "captured_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$", "type": "string"},
    "device_id": {"pattern": "^dev_[a-f0-9]{8,64}$", "type": "string"},
    "horizontal_accuracy_m": {"minimum": 0, "type": ["number", "null"]},
    "ingest_id": {"pattern": "^ing_[a-f0-9]{20,64}$", "type": "string"},
    "latitude": {"maximum": 90, "minimum": -90, "type": "number"},
    "longitude": {"maximum": 180, "minimum": -180, "type": "number"},
    "observation_id": {"pattern": "^obs_[a-f0-9]{32}$", "type": "string"},
    "privacy_class": {"const": "restricted", "type": "string"},
    "processed_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$", "type": "string"},
    "quality_flags": {"items": {"enum": ["future_timestamp", "implausible_speed", "late", "missing_accuracy", "out_of_order", "poor_accuracy", "source_transition_unconfirmed"], "type": "string"}, "type": "array"},
    "received_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$", "type": "string"},
    "schema_version": {"const": "1", "type": "string"},
    "source": {"const": "owntracks", "type": "string"},
    "source_digest": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "source_type": {"enum": ["location", "transition", "waypoint"], "type": "string"},
    "subject_id": {"pattern": "^sub_[a-f0-9]{8,64}$", "type": "string"}
  },
  "required": ["observation_id", "schema_version", "subject_id", "device_id", "source", "source_type", "captured_at", "received_at", "processed_at", "latitude", "longitude", "horizontal_accuracy_m", "quality_flags", "ingest_id", "source_digest", "algorithm", "algorithm_config_version", "privacy_class"],
  "title": "Hermodr canonical observation v1",
  "type": "object"
}
