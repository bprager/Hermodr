{
  "$id": "urn:hermodr:contract:v1:place",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {"const": "place-registry-v1", "type": "string"},
    "algorithm_config_version": {"pattern": "^[a-f0-9]{16}$", "type": "string"},
    "approval_state": {"enum": ["proposed", "approved", "rejected"], "type": "string"},
    "effective_from": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$", "type": "string"},
    "effective_until": {"type": ["string", "null"]},
    "latitude": {"maximum": 90, "minimum": -90, "type": "number"},
    "longitude": {"maximum": 180, "minimum": -180, "type": "number"},
    "place_id": {"pattern": "^plc_[a-f0-9]{32}$", "type": "string"},
    "privacy_class": {"const": "restricted", "type": "string"},
    "processed_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$", "type": "string"},
    "radius_m": {"minimum": 0.000001, "type": "number"},
    "schema_version": {"const": "1", "type": "string"},
    "sensitivity": {"enum": ["restricted", "private"], "type": "string"},
    "source_digest": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "subject_id": {"pattern": "^sub_[a-f0-9]{8,64}$", "type": "string"},
    "version": {"minimum": 1, "type": "integer"}
  },
  "required": ["place_id", "schema_version", "subject_id", "version", "latitude", "longitude", "radius_m", "sensitivity", "approval_state", "effective_from", "effective_until", "processed_at", "source_digest", "algorithm", "algorithm_config_version", "privacy_class"],
  "title": "Hermodr place v1",
  "type": "object"
}
