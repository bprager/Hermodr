[Unit]
Description=Create and restore-test an encrypted Hermodr backup
After=hermodr-migrate.service network-online.target
Requires=hermodr-migrate.service
Wants=network-online.target
RequiresMountsFor=/mnt/saga/Hermodr

[Service]
Type=oneshot
User=hermodr
Group=hermodr
Environment=LD_PRELOAD=/opt/hermodr/sqlite/lib/libsqlite3.so.0
Environment=HERMODR_OFFHOST_DIRECTORY=/mnt/saga/Hermodr
ExecStart=/usr/local/libexec/hermodr-backup
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hermodr /var/backups/hermodr /mnt/saga/Hermodr
RestrictAddressFamilies=AF_UNIX
UMask=0077
