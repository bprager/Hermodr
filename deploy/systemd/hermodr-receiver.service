[Unit]
Description=Hermodr durable location receiver
After=network-online.target hermodr-migrate.service
Wants=network-online.target
Requires=hermodr-migrate.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hermodr
Group=hermodr
Environment=LD_PRELOAD=/opt/hermodr/sqlite/lib/libsqlite3.so.0
ExecStart=/opt/hermodr/venv/bin/hermodr --config /etc/hermodr/config.json receiver
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hermodr
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=192.168.1.2
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
